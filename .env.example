# Scalekit environment and API credentials. Copy to .env and fill in. Never commit .env.
# Copy these three from Dashboard → Developers → Settings → API Credentials.
# The CLI plugin writes the connected-account identifier in ENTIRE_PLUGIN_DATA_DIR. Do not add it here.
SCALEKIT_ENV_URL=https://<your-environment>.scalekit.cloud
SCALEKIT_CLIENT_ID=
SCALEKIT_CLIENT_SECRET=
