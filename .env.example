# Scalekit environment and API credentials. Fill in, then copy to config.env in the plugin data directory:
#   install -m 600 .env "<path>"   (any entire scalekit command prints <path> when credentials are missing)
# That file works in every terminal. Never commit a filled-in copy.
# Copy these three from Dashboard → Developers → Settings → API Credentials.
# The CLI plugin writes the connected-account identifier in ENTIRE_PLUGIN_DATA_DIR. Do not add it here.
SCALEKIT_ENV_URL=https://<your-environment>.scalekit.cloud
SCALEKIT_CLIENT_ID=
SCALEKIT_CLIENT_SECRET=
